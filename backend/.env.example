# ApprenticeBridge Backend — environment variable template
# Copy to .env and fill in your values. Never commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/apprenticebridge

# ── Security ───────────────────────────────────────────────────────────────────
# Generate a strong random key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(40))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── Admin seed account ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# ── Gemini AI (optional) ───────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── File uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25

# ── Google OAuth (Firebase Admin SDK) ─────────────────────────────────────────
# To enable Google sign-in on the backend:
# 1. Go to Firebase Console → Project Settings → Service Accounts
# 2. Click "Generate new private key" → download the JSON file
# 3. Save the JSON file somewhere safe (NOT in the repo)
# 4. Set the path below
# Leave blank to skip Google OAuth server-side verification
FIREBASE_SERVICE_ACCOUNT_PATH=
